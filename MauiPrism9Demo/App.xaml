<?xml version="1.0" encoding="UTF-8" ?>
<Application x:Class="MauiPrism9Demo.App"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:languages="clr-namespace:MyResources.Languages;assembly=MyResources"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary x:Name="AppColors" Source="Resources/Styles/Colors.xaml" />

                <ResourceDictionary x:Name="AppStyles" Source="Resources/Styles/Styles.xaml" />

                <ResourceDictionary Source="Resources/Styles/LightTheme.xaml" />

                <languages:zh_CN />


                <!--<ResourceDictionary Source="resources/Languages/Language.xaml" />-->
                <!--<ResourceDictionary Source="/Languages/Language_zh-cn.xaml;assembly=Resources" />-->


                <material:StyleResource BasedOn="{x:Reference AppStyles}" ColorsOverride="{x:Reference AppColors}" />

                <!--<ResourceDictionary Source="Resources/Styles/DarkTheme.xaml" />-->

            </ResourceDictionary.MergedDictionaries>


        </ResourceDictionary>
    </Application.Resources>
</Application>
